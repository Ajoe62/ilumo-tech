---
import { audiences, domainHref } from "../data/site";

const icons = {
  school: `<path d="M2 9l10-5 10 5-10 5L2 9z"/><path d="M6 11v5c0 1.5 2.7 3 6 3s6-1.5 6-3v-5"/>`,
  business: `<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 012-2h4a2 2 0 012 2v2"/>`,
  brand: `<path d="M3 11l15-6v14L3 13v-2z"/><path d="M7 13v5a2 2 0 004 0v-4"/>`,
  learner: `<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7"/>`,
};
---

<section class="audience" aria-labelledby="audience-title">
  <div class="container">
    <h2 id="audience-title" class="audience-title">Find where we can help you</h2>
    <div class="audience-grid">
      {
        audiences.map((a) => (
          <a href={domainHref(a.target)} class="audience-card reveal">
            <span class="audience-icon">
              <svg viewBox="0 0 24 24" set:html={icons[a.icon]} />
            </span>
            <span class="audience-who">{a.who}</span>
            <span class="audience-what">{a.what}</span>
          </a>
        ))
      }
    </div>
  </div>
</section>
