---
interface Props {
  title?: string;
  text?: string;
  label?: string;
  href?: string;
}

const {
  title = "Let's make technology work for you",
  text = "Tell us what you need, and we'll recommend the right solution, product or training.",
  label = "Get in touch",
  href = "/contact",
} = Astro.props;
---

<section class="cta-band">
  <div class="container cta-inner reveal">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <a href={href} class="btn btn-light">{label}</a>
  </div>
</section>
