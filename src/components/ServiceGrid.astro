---
import ServiceCard from "./ServiceCard.astro";
import type { Domain } from "../data/site";

interface Props {
  items: Domain[];
}

const { items } = Astro.props;

// 4 cards sit in one row; 5 sit as 3 + 2 (centred). Alternate navy and white either way.
const cols = items.length === 4 ? 4 : 3;
---

<div class="svc-grid" data-cols={cols}>
  {items.map((domain, i) => <ServiceCard domain={domain} tone={i % 2 === 0 ? "dark" : "light"} />)}
</div>
