---
import { getDomain, domainHref, contactHref } from "../data/site";

const domain = getDomain("ai-automation");
const points = [
  { title: "Save time", text: "Agents handle replies, follow-ups and data entry." },
  { title: "Respond 24/7", text: "Answer customers on your website, WhatsApp and Instagram." },
  { title: "Grow without extra hires", text: "Your tools work together, so your team can focus on growth." },
];
---

<section class="section featured" aria-labelledby="featured-title">
  <div class="container featured-inner reveal">
    <div class="featured-copy">
      <p class="eyebrow light"><span class="new-badge">New</span> {domain.title}</p>
      <h2 id="featured-title">{domain.tagline}</h2>
      <p>{domain.description}</p>
      <div class="hero-actions">
        <a href={contactHref(domain.id, domain.cta.subject)} class="btn btn-light">{domain.cta.label}</a>
        <a href={domainHref(domain.id)} class="btn btn-outline-light">See how it works</a>
      </div>
    </div>
    <ul class="featured-points">
      {
        points.map((p) => (
          <li>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12l5 5 9-10" /></svg>
            <span>
              <strong>{p.title}</strong>
              {p.text}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
