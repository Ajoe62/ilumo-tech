---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import HomeServices from "../components/HomeServices.astro";
import FeaturedService from "../components/FeaturedService.astro";
import ProductCards from "../components/ProductCards.astro";
import Process from "../components/Process.astro";
import CtaBand from "../components/CtaBand.astro";
---

<BaseLayout>
  <Hero />
  <HomeServices />
  <FeaturedService />

  <section class="section surface" aria-labelledby="products-title">
    <div class="container products-teaser">
      <div class="section-head left">
        <p class="eyebrow">Our Products</p>
        <h2 id="products-title">Education platforms built by ilumo</h2>
        <p>Products we own and build to help schools assess students, automate grading and improve learning.</p>
        <a href="/products" class="btn btn-primary">View our products</a>
      </div>
      <ProductCards compact />
    </div>
  </section>

  <Process />
  <CtaBand />
</BaseLayout>
